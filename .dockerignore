# The deployed image is built from the repository as committed: its two build
# stages install Composer and npm dependencies themselves, so anything the
# host happens to have under vendor/ or node_modules/ only slows the context
# upload down and risks shipping a locally-built artifact.
.git
.gitattributes
.github
.ai
.claude
.cursor
.editorconfig
.env
.env.*
.mcp.json
.npmrc
node_modules
vendor

# Rebuilt by the node stage.
public/build
public/hot
public/storage

# The runtime writes these; only the directories themselves need to exist, and
# the committed .gitignore files are what create them.
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/pail
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Development-only: the Sail runtime, the local compose stack, the Kubernetes
# manifests, the test suite, and any database dump sitting in the working tree.
compose.yaml
docker/8.5
docker/pgsql
kubernetes
tests
phpunit.xml
*.dump
*.md
