APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_PORT=9000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5433

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Source PDFs for the book extraction pipeline. Defaults to the reference
# project's corpus, which is gitignored and not part of this repository.
# BOOKS_PATH=/absolute/path/to/pdfs
BOOKS_CONCURRENCY=8
BOOKS_STRATEGY=ocr_all

# Text Embeddings Inference, served by the tei-embed and tei-rerank containers.
# These are the URLs as seen from inside the Docker network; from the host the
# same services are on localhost:8080 and localhost:8081.
TEI_EMBED_URL=http://tei-embed:80/v1
TEI_RERANK_URL=http://tei-rerank:80

# The embedding model and its dimensions are pinned to the vector column's own
# typmod by BookChunkEmbeddingSchemaTest -- changing either needs a migration.
BOOKS_EMBEDDING_MODEL=BAAI/bge-m3
BOOKS_EMBEDDING_DIMENSIONS=1024
BOOKS_EMBEDDING_BATCH=32

# Reranking is local, so it costs latency rather than money. Lower
# BOOKS_RERANK_CANDIDATES before turning the stage off.
#
# On Apple Silicon set this to false. TEI has no arm64 build, so it runs under
# emulation, and reranking 40 passages there measures 66 seconds against the
# 0.5-1.5s the same image costs on amd64. Retrieval degrades to the fused RRF
# order, which is most of the quality anyway.
BOOKS_RERANK_ENABLED=true
BOOKS_RERANK_CANDIDATES=40
BOOKS_RERANK_TIMEOUT=30

# The answering model is a separate concern from the embedding one; ai.default
# stays on OpenAI and the three ai.default_for_* keys resolve independently.
#
# Unset, the driver picks its own default text model, which is the expensive
# tier. Eddie's answers are short and the retrieval work is already done by the
# time the model sees them, so the cheap tier is what runs.
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# The drink tally (books:drinks) is derived from text already in the database,
# so nothing here costs inference.
#
# Fuzzy merging folds two keys one edit apart into one drink. It defaults off
# and should stay off until `books:drinks --merges` has been read against the
# real corpus: one edit catches the OCR substitution ("BLUE LADV") and it also
# merges "Brandy Sour" into "Brandy Soup", and no threshold separates the two.
# A wrong merge produces a citation that passes every check the layer makes.
BOOKS_DRINKS_FUZZY=false
BOOKS_DRINKS_FUZZY_MIN_LENGTH=6
BOOKS_DRINKS_FUZZY_MAX_EDITS=1

BOOKS_DRINKS_SURVEY_LIMIT=10
BOOKS_DRINKS_SURVEY_MAX=25
BOOKS_DRINKS_SURVEY_CITATIONS=3
